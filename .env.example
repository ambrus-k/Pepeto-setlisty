# MobileSheets Setlist Studio - Environment Configuration Template

# Google Drive OAuth2 Credentials (Direct owner account access - solves Service Account quota issues)
# Create in Google Cloud Console: APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-oauth-client-secret"
GOOGLE_REFRESH_TOKEN="your-oauth-refresh-token"

# Optional fallback: Service Account credentials (if still desired as secondary option)
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_PROJECT_ID=""

# Google Drive Folder IDs (or full folder URLs: drive.google.com/drive/folders/<FOLDER_ID>)
GOOGLE_DRIVE_DATA_FOLDER_ID="1pZuDqPX6OVbGoYdfOg_p3DqJ0cEhAiq2"
GOOGLE_DRIVE_EXPORT_FOLDER_ID="1gvZxnQDDdQtIMGO7-ai877tdZcYysfs-"

# Access PINs
# Regular Band Musician PIN (grants setlist building & silent export to Drive, hides admin/drive settings)
USER_PIN="2004"
# Band Admin PIN (grants forced sync, folder configuration and server error logs)
ADMIN_PIN="251925"

# Server Port
PORT=3000
